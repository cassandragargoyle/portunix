# =============================================================================
# Build artifacts
# =============================================================================

# Main binary (Linux + Windows + backup + zipped distro)
/portunix
portunix.exe
portunix.backup
portunix-windows.zip

# Helper binaries — Git-like dispatcher pattern (ptx-*)
# Covers both repo-root output and per-helper local builds.
/ptx-*
ptx-*.exe
src/helpers/ptx-*/ptx-*
src/helpers/ptx-*/ptx-*.exe

# Distribution / build outputs
/dist/
/bin/
*.msi

# AUR repository (release tooling)
/aur-repo/

# Go debug binaries (delve)
__debug_bin*

# =============================================================================
# Test artifacts
# =============================================================================

# Go coverage + test outputs
coverage.out
coverage.html
test/results/
test/logs/
test/tmp/

# Test plugin builds
test/test-plugin/test-plugin
test-plugin.exe

# Python venv + test artifacts
.venv/
test/venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# =============================================================================
# Caches / temp
# =============================================================================
.tmp
.cache
tmpclaude-*-cwd

# =============================================================================
# Local developer files (never commit)
# =============================================================================

# Claude / AI tooling
CLAUDE.local.md
.claude/roles/current.md
.claude/settings.local.json
.claude/settings.json

# Local helper scripts
cleanup-public.ps1

# Local config
portunix-config.yaml
test/unit/.portunix/config.yaml
/.pft-config.json
/pft-demo

# =============================================================================
# Generated content
# =============================================================================

# GitHub sync staging
.portunix-github-sync/

# Generated playbooks
generated-playbooks/

# Hugo docs site
docs-site/public/
docs-site/resources/
docs-site/.hugo_build.lock
.hugo_build.lock

# Translation files (regenerated on demand)
.translated/

# =============================================================================
# Secrets — NEVER commit (Issue #165, ADR-042)
# =============================================================================
*.key
*.pem
private.key
secrets/
