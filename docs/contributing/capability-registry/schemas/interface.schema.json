{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "interface.schema.json",
  "title": "Interface node",
  "description": "Access mechanism through which a capability is reachable.",
  "type": "object",
  "required": ["id", "name", "type", "verification"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^interface:[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
      "description": "interface:<product>.<name>"
    },
    "name": { "type": "string" },
    "type": {
      "enum": ["rest", "grpc", "cli", "graphql", "soap", "webhook", "sdk", "file", "other"]
    },
    "description": { "type": "string" },
    "spec": {
      "type": "string",
      "description": "Link to OpenAPI/proto/man page describing the interface."
    },
    "verification": { "$ref": "verification.schema.json" }
  }
}
