{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "product.schema.json",
  "title": "Product node",
  "type": "object",
  "required": ["id", "name", "type", "composition", "verification"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^product:[a-z][a-z0-9-]*$",
      "description": "product:<slug>"
    },
    "name": { "type": "string" },
    "type": {
      "enum": ["software", "service", "platform"],
      "description": "What the product is (orthogonal to composition)."
    },
    "composition": {
      "enum": ["monolith", "modular"],
      "description": "monolith: provides hangs on the product. modular: create module nodes."
    },
    "vendor": { "type": "string" },
    "description": { "type": "string" },
    "website": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "verification": { "$ref": "verification.schema.json" }
  }
}
