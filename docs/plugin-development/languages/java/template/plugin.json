{
  "name": "java-plugin-template",
  "version": "1.0.0",
  "description": "Template for Java-based Portunix plugins",
  "author": "Your Name",
  "license": "MIT",
  "plugin": {
    "type": "grpc",
    "binary": "target/my-java-plugin-1.0.0.jar",
    "runtime": "java",
    "runtime_version": ">=17",
    "port": 9001,
    "health_check_interval": 30000000000
  },
  "dependencies": {
    "portunix_min_version": "1.10.0",
    "os_support": ["linux", "windows", "darwin"],
    "system": {
      "java": ">=17"
    }
  },
  "ai_integration": {
    "mcp_tools": [
      {
        "name": "example_tool",
        "description": "Example tool for demonstration"
      }
    ]
  },
  "permissions": {
    "filesystem": ["read"],
    "network": ["outbound"],
    "database": [],
    "system": [],
    "level": "limited"
  },
  "commands": [
    {
      "name": "hello",
      "description": "Print a greeting",
      "subcommands": [],
      "parameters": [
        {
          "name": "name",
          "type": "string",
          "description": "Name to greet",
          "required": false,
          "default_value": "World"
        }
      ],
      "examples": ["portunix plugin-name hello", "portunix plugin-name hello Portunix"]
    }
  ]
}
