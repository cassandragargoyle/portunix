{
  "apiVersion": "v1",
  "kind": "Package",
  "metadata": {
    "name": "hugo-extended",
    "displayName": "Hugo Extended",
    "description": "Hugo Static Site Generator with extended features (Sass/SCSS support)",
    "category": "development/tools",
    "homepage": "https://gohugo.io/",
    "documentation": "https://gohugo.io/documentation/",
    "license": "Apache-2.0",
    "maintainer": "Hugo Authors",
    "installationDocsUrl": "https://gohugo.io/installation/",
    "latestVersionUrl": "https://github.com/gohugoio/hugo/releases/latest"
  },
  "spec": {
    "hasVariants": true,
    "platforms": {
      "windows": {
        "type": "zip",
        "variants": {
          "extended": {
            "version": "0.167.0",
            "urls": {
              "x64": "https://github.com/gohugoio/hugo/releases/download/v0.167.0/hugo_extended_0.167.0_windows-amd64.zip"
            },
            "extractTo": "C:/Program Files/Hugo"
          }
        },
        "verification": {
          "command": "hugo version",
          "expectedExitCode": 0
        },
        "environment": {
          "PATH_APPEND": "C:/Program Files/Hugo"
        }
      },
      "linux": {
        "type": "tar.gz",
        "variants": {
          "extended": {
            "version": "0.167.0",
            "urls": {
              "x64": "https://github.com/gohugoio/hugo/releases/download/v0.167.0/hugo_extended_0.167.0_linux-amd64.tar.gz"
            },
            "extractTo": "/usr/local/bin",
            "postInstall": [
              "${sudo_prefix}chmod +x /usr/local/bin/hugo"
            ]
          }
        },
        "verification": {
          "command": "hugo version",
          "expectedExitCode": 0
        }
      }
    },
    "aiPrompts": {
      "versionDiscovery": "Check GitHub API for Hugo releases. This is the extended version with Sass/SCSS support.",
      "urlResolution": "hugo_extended_{version}_{os}-{arch}.{ext}",
      "updateGuidance": "Monitor Hugo extended releases. Extended version includes Sass/SCSS processing capabilities."
    },
    "dependencies": [],
    "templates": ["zip-archive", "tar-archive"]
  }
}