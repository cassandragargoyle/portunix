apiVersion: portunix.ai/v1
kind: Playbook
metadata:
  name: "{{ .Name }}"
  description: "Static documentation site using VitePress (Vue + Vite)"

spec:
  environment:
    target: {{ .Target }}
{{- if eq .Target "container" }}
    runtime: {{ .ContainerRuntime }}
    image: "node:22"
    container_name: "{{ .Name }}-vitepress"
    ports:
      - "5173:5173"
    volumes:
      # Source code on host (editable)
      - "./site:/workspace/site"
      # Named volumes for node_modules and npm cache (fast, persistent)
      - "{{ .Name }}_node_modules:/workspace/site/node_modules:named"
      - "{{ .Name }}_npm_cache:/root/.npm:named"
{{- end }}

  variables:
    site_title: "{{ .Name }} Documentation"
    output_dir: "./site/docs/.vitepress/dist"

{{- if eq .Target "local" }}
  portunix:
    packages:
      - name: "nodejs"
        variant: "20"
{{- end }}

  # Scripts are separated for flexible execution:
  # - create: One-time project initialization (run once)
  # - dev: Development server with hot reload (port 5173)
  # - build: Production build (CI/CD only)
  # - serve: Preview production build
  #
  # Usage examples:
  #   portunix playbook run my-docs.ptxbook --script create    # First time only
  #   portunix playbook run my-docs.ptxbook --script dev       # Development
  #   portunix playbook run my-docs.ptxbook --script build     # Production build
  #   portunix playbook run my-docs.ptxbook --list-scripts     # Show all scripts
  scripts:
{{- if and (eq .OS "windows") (eq .Target "local") }}
    create: "portunix install vitepress --path ./site"
    dev: "cd site && npm.cmd install && npm.cmd run docs:dev"
    build: "cd site && npm.cmd ci && npm.cmd run docs:build"
    serve: "cd site && npm.cmd run docs:preview"
{{- else if eq .Target "container" }}
    # Internal script: copy Portunix binaries to container (runs first automatically)
    internal:bin-update: "builtin"
    # Use portunix install for consistent experience
    create: "portunix install vitepress --path /workspace/site"
    dev: "cd /workspace/site && npm install && npm run docs:dev -- --host 0.0.0.0"
    build: "cd /workspace/site && npm ci && npm run docs:build"
    serve: "cd /workspace/site && npm run docs:preview -- --host 0.0.0.0"
{{- else }}
    create: "portunix install vitepress --path ./site"
    dev: "cd site && npm install && npm run docs:dev"
    build: "cd site && npm ci && npm run docs:build"
    serve: "cd site && npm run docs:preview"
{{- end }}
