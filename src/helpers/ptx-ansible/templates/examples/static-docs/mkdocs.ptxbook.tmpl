apiVersion: portunix.ai/v1
kind: Playbook
metadata:
  name: "{{ .Name }}"
  description: "Static documentation site using MkDocs with Material theme"

spec:
  environment:
    target: {{ .Target }}
{{- if eq .Target "container" }}
    runtime: {{ .ContainerRuntime }}
    image: "python:3.12-slim"
    container_name: "{{ .Name }}-mkdocs"
    ports:
      - "8000:8000"
    volumes:
      # Source code on host (editable)
      - "./:/workspace"
      # Named volume for pip cache (fast, persistent across runs)
      - "{{ .Name }}_pip_cache:/root/.cache/pip:named"
{{- end }}

  variables:
    site_title: "{{ .Name }} Documentation"
    output_dir: "./site"

{{- if eq .Target "local" }}
  portunix:
    packages:
      - name: "python"
{{- end }}

  # Scripts are separated for flexible execution:
  # - create: One-time project initialization (run once)
  # - dev: Development server with hot reload (port 8000)
  # - build: Production build (CI/CD only)
  # - serve: Serve the built site (uses --no-livereload for production preview)
  #
  # Usage examples:
  #   portunix playbook run my-docs.ptxbook --script create    # First time only
  #   portunix playbook run my-docs.ptxbook --script dev       # Development
  #   portunix playbook run my-docs.ptxbook --script build     # Production build
  #   portunix playbook run my-docs.ptxbook --list-scripts     # Show all scripts
  scripts:
{{- if and (eq .OS "windows") (eq .Target "local") }}
    create: "portunix install mkdocs && mkdocs new ."
    dev: "mkdocs serve"
    build: "mkdocs build"
    serve: "mkdocs serve --no-livereload"
{{- else if eq .Target "container" }}
    # Internal script: copy Portunix binaries to container (runs first automatically)
    internal:bin-update: "builtin"
    # Install MkDocs + Material theme, then scaffold project if missing
    # PATH override covers both system-wide (root pip) and per-user (~/.local/bin) installs
    create: "portunix install mkdocs && export PATH=$HOME/.local/bin:$PATH && cd /workspace && (test -f mkdocs.yml || mkdocs new .)"
    dev: "export PATH=$HOME/.local/bin:$PATH && cd /workspace && mkdocs serve --dev-addr 0.0.0.0:8000"
    build: "export PATH=$HOME/.local/bin:$PATH && cd /workspace && mkdocs build"
    serve: "export PATH=$HOME/.local/bin:$PATH && cd /workspace && mkdocs serve --dev-addr 0.0.0.0:8000 --no-livereload"
{{- else }}
    create: "portunix install mkdocs && export PATH=$HOME/.local/bin:$PATH && mkdocs new ."
    dev: "export PATH=$HOME/.local/bin:$PATH && mkdocs serve"
    build: "export PATH=$HOME/.local/bin:$PATH && mkdocs build"
    serve: "export PATH=$HOME/.local/bin:$PATH && mkdocs serve --no-livereload"
{{- end }}
